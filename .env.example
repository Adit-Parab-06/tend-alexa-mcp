# Tend Environment Configuration
# Copy this file to .env for local development

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# OAuth 2.1 Configuration
OAUTH_CLIENT_ID=alexa-client-tend
OAUTH_CLIENT_SECRET=change-in-production-never-commit-secrets
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-chars
RESOURCE_INDICATOR=https://tend.care/mcp

# AWS Infrastructure (Phase 4 & 5)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=tend-main-table
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
SNS_ALERTS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:tend-alerts
